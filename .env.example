# Copie este arquivo para `.env` e preencha a chave.
#
# A chave da YouTube Data API v3 é obtida em console.cloud.google.com:
# criar um projeto, ativar "YouTube Data API v3" e gerar uma chave em
# "Credenciais". A cota padrão é de 10.000 unidades por dia — cada vídeo
# processado consome 1 unidade de metadados e 1 por página de comentários.
YOUTUBE_API_KEY=

# Caminhos (os valores abaixo são os padrões; descomente para alterar)
# DB_PATH=data/videos.db
# AUDIO_PATH=media/audio
# VIZ_PATH=media/visualizations
# EXCEL_PATH=media/exports/laplace.xlsx

# Modelo do faster-whisper. large-v3 é o usado no artigo; variantes menores
# (medium, small) rodam em menos VRAM com perda de acurácia na transcrição.
# WHISPER_MODEL=large-v3

# Token do HuggingFace (opcional, mas recomendado).
# Sem ele, as requisições ao Hub são anônimas e sujeitas a limite de taxa:
# um HTTP 429 ao carregar o classificador de emoção faz a etapa 4c ser
# pulada, e o fingerprint sai sem `emotion_dominant`. Gere um token de
# leitura em huggingface.co/settings/tokens.
HF_TOKEN=
